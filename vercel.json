{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:css",
  "outputDirectory": "src",
  "rewrites": [
    {
      "source": "/project",
      "destination": "/pages/projects.html"
    },
    {
      "source": "/project/",
      "destination": "/pages/projects.html"
    }
  ]
}
